# Variables d'environnement du kit de démarrage (variante Podman).
# Ce fichier est un exemple : copiez-le en .env et ne committez jamais de vraies valeurs secrètes.
TZ=America/Toronto
COMPOSE_PROJECT_NAME=starter-kit-podman

# Socket API Podman (compatible Docker), activé par systemctl --user enable --now podman.socket
# Vérifiez la valeur réelle avec : echo $XDG_RUNTIME_DIR/podman/podman.sock
PODMAN_SOCK=/run/user/1000/podman/podman.sock
