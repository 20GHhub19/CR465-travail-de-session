# Variables d'environnement du kit de démarrage (mode rootless).
# Ce fichier est un exemple : copiez-le en .env et ne committez jamais de vraies valeurs secrètes.
TZ=America/Toronto
COMPOSE_PROJECT_NAME=starter-kit-rootless

# Chemin du socket Docker rootless. Vérifiez la valeur réelle avec :
#   echo $XDG_RUNTIME_DIR/docker.sock
# (typiquement /run/user/<uid>/docker.sock, où <uid> est l'UID de l'utilisateur admin)
DOCKER_SOCK=/run/user/1000/docker.sock
