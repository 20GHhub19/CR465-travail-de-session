    {
      "parameters": {
        "jsCode": "// Verifie la signature HMAC-SHA256 du webhook (X-CR465-Signature).\n// Drupal signe le corps brut avec le secret partage ; n8n recalcule et compare.\nconst crypto = require('crypto');\nconst secret = '__WEBHOOK_SECRET__';\n\nconst wh = $('Webhook commande').item.json;\nconst raw = typeof wh.body === 'string' ? wh.body : JSON.stringify(wh.body);\nconst received = String(wh.headers['x-cr465-signature'] || '').toLowerCase();\nconst expected = crypto.createHmac('sha256', secret).update(raw).digest('hex');\n\nlet corps = {};\ntry { corps = typeof wh.body === 'string' ? JSON.parse(wh.body) : wh.body; } catch (e) {}\n\nconst valid = received.length > 0 && received === expected;\nreturn [{ json: { valid, email: corps.email || null, order_id: corps.order_id || null } }];"
      },
      "id": "a1b2c3d4-0006-4000-8000-000000000006",
      "name": "Verifier signature HMAC",
