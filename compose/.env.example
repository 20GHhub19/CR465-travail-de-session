# ============================================================
# .env.example — MODELE utilise pour creer .env
# Valeurs factices : AUCUN secret reel dans ce fichier.
# Usage : cp compose/.env.example compose/.env  puis remplir .env
# Le vrai .env ne doit JAMAIS etre commite (voir .gitignore).
# ============================================================
# IMPORTANT : aucun commentaire en fin de ligne. Selon le parseur,
# tout ce qui suit la valeur peut etre integre a la valeur elle-meme.

# --- Domaine de base ---
# Sous-domaines utilises par Traefik :
#   shop.cr465.test (Drupal) | lms.cr465.test (Moodle)
#   auth.cr465.test (Keycloak) | flow.cr465.test (n8n)
#   admin.cr465.test (Portainer)
BASE_DOMAIN=cr465.test

# --- PostgreSQL (instance unique, bases logiques par service) ---
POSTGRES_SUPERPASS=changeme_postgres_superpass

# --- Keycloak (identite / SSO) ---
# Nom de la base logique reservee a Keycloak
KC_DB_NAME=keycloak
# Utilisateur PostgreSQL proprietaire de cette base
KC_DB_USER=keycloak
KC_DB_PASSWORD=changeme_kc_db
# Compte d'administration de la console web Keycloak
KC_ADMIN=admin
KC_ADMIN_PASSWORD=changeme_kc_admin

# --- Moodle (LMS) ---
MOODLE_DB_NAME=moodle
MOODLE_DB_USER=moodle
MOODLE_DB_PASSWORD=changeme_moodle_db
# Compte administrateur de l'application Moodle
MOODLE_ADMIN_USER=admin
MOODLE_ADMIN_PASSWORD=changeme_moodle_admin

# --- Drupal Commerce (boutique) ---
DRUPAL_DB_NAME=drupal
DRUPAL_DB_USER=drupal
DRUPAL_DB_PASSWORD=changeme_drupal_db

# --- n8n (integration / workflow) ---
N8N_DB_NAME=n8n
N8N_DB_USER=n8n
N8N_DB_PASSWORD=changeme_n8n_db
# Generation du secret : openssl rand -hex 32
N8N_ENCRYPTION_KEY=changeme_32_caracteres_minimum

# --- Redis (BONUS cache / sessions) : decommenter si utilise ---
# REDIS_PASSWORD=changeme_redis
