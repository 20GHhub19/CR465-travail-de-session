# ============================================================
# .env.example — MODÈLE qui sera utilisé pour créer .env
#(valeurs factices, AUCUN secret réel)
# Usage : cp compose/.env.example compose/.env  puis remplir .env
# NB Le vrai .env ne doit JAMAIS être commité (voir .gitignore).
# ============================================================

# --- Domaine de base (sous-domaines utilisés par Traefik 
#     pour fabriquer les adresses de chaque service 
#     ex : shop.example.lan pour Drupal, lms.example.lan pour Moodle) ---
BASE_DOMAIN=exemple.lan

# --- PostgreSQL (instance unique, bases logiques par service) ---
POSTGRES_SUPERPASS=changeme_postgres_superpass

# --- Keycloak (identité / SSO) --- pour connecter Keycloak à sa base de données
KC_DB_NAME=keycloak             # Le nom de la base logique réservée à Keycloak
KC_DB_USER=keycloak             # Utilisateur PostGreSQL propriétaire de la base
KC_DB_PASSWORD=changeme_kc_db   # Mot de passe de cet utilisateur
KC_ADMIN=admin                  # Pour se connecter à l'interface web d'administration
KC_ADMIN_PASSWORD=changeme_kc_admin

# --- Moodle (LMS) --- Connexion de Moodle à sa base 
MOODLE_DB_NAME=moodle
MOODLE_DB_USER=moodle
MOODLE_DB_PASSWORD=changeme_moodle_db
MOODLE_ADMIN_USER=admin         # Pour se connecter au compte administrateur de l'application Moodle
MOODLE_ADMIN_PASSWORD=changeme_moodle_admin

# --- Drupal Commerce (boutique) ---
DRUPAL_DB_NAME=drupal
DRUPAL_DB_USER=drupal
DRUPAL_DB_PASSWORD=changeme_drupal_db

# --- n8n (intégration / workflow) ---  
#     n8n stocke dans ses workflows les identifiants sensibles
# génération du secret: openssl rand -hex 32
N8N_DB_NAME=n8n
N8N_DB_USER=n8n
N8N_DB_PASSWORD=changeme_n8n_db
N8N_ENCRYPTION_KEY=changeme_32_caracteres_minimum

# --- Redis (BONUS cache/sessions) — décommenter si utilisé ---
# REDIS_PASSWORD=changeme_redis
